{
  "name": "@credonomics/rewards-engine",
  "version": "0.2.0-alpha.3",
  "description": "Transparent, deterministic India-focused credit card cashback rules engine (fictional examples only)",
  "type": "module",
  "license": "MIT",
  "private": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schemas/rule-catalog.v1.schema.json": "./schemas/rule-catalog.v1.schema.json",
    "./catalog-schema-validator": {
      "types": "./bin/catalog-schema-validator.d.mts",
      "default": "./bin/catalog-schema-validator.mjs"
    }
  },
  "bin": {
    "credorewards": "bin/credorewards.mjs",
    "credorewards-catalog": "bin/credorewards-catalog.mjs",
    "credorewards-batch": "bin/credorewards-batch.mjs"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE",
    "schemas"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "demo": "npm run build && node bin/credorewards.mjs examples/fictional-card.json",
    "test:package": "npm run build && node tests/package-smoke.mjs",
    "validate:catalog": "npm run build && node scripts/check-catalog.mjs examples/fictional-catalog.json",
    "demo:batch": "npm run build && node bin/credorewards-batch.mjs examples/fictional-batch.json",
    "verify:release": "npm run typecheck && npm test && npm run test:package && npm run validate:catalog && npm pack --dry-run --ignore-scripts"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "keywords": [
    "fintech",
    "india",
    "credit-cards",
    "cashback",
    "rewards",
    "sdk",
    "open-source"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aqdas1820/credorewards-engine.git"
  },
  "homepage": "https://github.com/aqdas1820/credorewards-engine#readme",
  "bugs": {
    "url": "https://github.com/aqdas1820/credorewards-engine/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  }
}
